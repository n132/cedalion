diff --git a/include/net/netfilter/br_netfilter.h b/include/net/netfilter/br_netfilter.h
index 371696ec11b2..e30f69f08f31 100644
--- a/include/net/netfilter/br_netfilter.h
+++ b/include/net/netfilter/br_netfilter.h
@@ -3,6 +3,7 @@
 #define _BR_NETFILTER_H_
 
 #include <linux/netfilter.h>
+#include <linux/netfilter_bridge.h>
 
 #include "../../../net/bridge/br_private.h"
 
@@ -52,6 +53,24 @@ static inline struct rtable *bridge_parent_rtable(const struct net_device *dev)
 #endif
 }
 
+/* The ingress bridge port is remembered as a bare ifindex, and the skb can
+ * leave the RCU section it was received in (ipv4/ipv6 defrag, neighbour
+ * queue, qdisc on the bridge device) before it is pushed back into the
+ * bridge path.  By then the device may no longer be a bridge port; it may
+ * even have been enslaved to a different virtual device, in which case
+ * rx_handler_data no longer points at a struct net_bridge_port.
+ */
+static inline struct net_device *nf_bridge_get_physinport(const struct sk_buff *skb,
+							  struct net *net)
+{
+	struct net_device *dev = nf_bridge_get_physindev(skb, net);
+
+	if (dev && !netif_is_bridge_port(dev))
+		return NULL;
+
+	return dev;
+}
+
 struct net_device *setup_pre_routing(struct sk_buff *skb,
 				     const struct net *net);
 

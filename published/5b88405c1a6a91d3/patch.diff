@@ -367,6 +367,35 @@ ip_set_init_comment(struct ip_set *set, struct ip_set_comment *comment,
 }
 EXPORT_SYMBOL_GPL(ip_set_init_comment);

+/* Replace the comment pointer with an independent copy of its current
+ * value.  Called on the new-table element right after mtype_resize()
+ * memcpy()s the old element, so that the old and new tables do not share
+ * one ip_set_comment_rcu object and cannot free it twice.
+ */
+void
+ip_set_comment_dup(struct ip_set *set, struct ip_set_comment *comment)
+{
+	struct ip_set_comment_rcu *c = rcu_dereference_protected(comment->c, 1);
+	struct ip_set_comment_rcu *dup;
+	size_t len;
+
+	if (likely(!c)) {
+		rcu_assign_pointer(comment->c, NULL);
+		return;
+	}
+	len = strlen(c->str);
+	dup = kmalloc(sizeof(*dup) + len + 1, GFP_ATOMIC);
+	if (unlikely(!dup)) {
+		/* Do not share the source object; drop the comment instead. */
+		rcu_assign_pointer(comment->c, NULL);
+		return;
+	}
+	memcpy(dup->str, c->str, len + 1);
+	set->ext_size += sizeof(*dup) + len + 1;
+	rcu_assign_pointer(comment->c, dup);
+}
+EXPORT_SYMBOL_GPL(ip_set_comment_dup);
+
 /* Used only when dumping a set, protected by rcu_read_lock() */
